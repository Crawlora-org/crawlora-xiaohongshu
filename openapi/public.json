    "app.Response": {
      "description": "The Response struct is used for wrapping the API response with a code, message, and data.",
      "properties": {
        "code": {
          "description": "Code is the HTTP status code or a custom code used to indicate the result of the request\n@example 200",
          "type": "integer"
        },
        "data": {
          "description": "Data is the response data (can be any object or null)\n@example {\"id\": 1, \"name\": \"John Doe\"}"
        },
        "msg": {
          "description": "Msg is the message that describes the result of the request\n@example \"Request successful\""
        }
      },
      "type": "object"
    },
