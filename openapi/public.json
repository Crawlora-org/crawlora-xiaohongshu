  "host": "api.crawlora.net",
  "info": {
    "contact": {
      "email": "support@crawlora.net",
      "name": "API Support",
      "url": "https://crawlora.net"
    },
    "description": "Crawlora is a hosted web-data and SERP API: call documented REST endpoints and get normalized JSON instead of HTML to parse — across search/SERP, maps and local, e-commerce, app stores, social, media and finance. One API key; Crawlora runs the proxy rotation, headless browsers and parsing behind the scenes. Billed pay-on-success: charged only on a successful 2xx response, 1-10 credits per call, with a free tier of 2,000 credits per month and no card. A hosted MCP server (mcp.crawlora.net/mcp) exposes the same catalog as agent tools. Search endpoints accept `q` as a universal alias for whichever search-term parameter they document (`query`, `term`, `keyword`, or Amazon's `k`), so one parameter name works across the whole catalog; an explicitly supplied documented name always wins.",
    "license": {
      "name": "Crawlora Terms of Service",
      "url": "https://crawlora.net/terms"
    },
    "termsOfService": "https://crawlora.net/terms",
    "title": "Crawlora API",
    "version": "1.2",
    "x-logo": {
      "altText": "Crawlora",
      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/xiaohongshu/explore": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one page of the anonymous Xiaohongshu explore feed as normalized note cards: note id, a ready-to-call note_url carrying its short-lived xsec_token, type, title, cover image, like count, and a public author card. Omit channel_id for the upstream default recommendation feed; use channel_id with an id from the channels list returned by this endpoint for a category feed. The upstream serves one server-rendered page per channel (typically 20-33 cards) and has no credential-free cursor, so there is no pagination. Search, user profiles, comments, and note detail without a feed token are not available on this anonymous surface. The xsec_token in note_url is short-lived; call /xiaohongshu/note promptly with the returned note_url, and re-run this endpoint for a fresh token when it expires.",
        "operationId": "xiaohongshu-explore",
        "parameters": [
          {
            "description": "Optional explore channel id from the channels list in a previous response. Unknown values are rejected; omit for the default feed.",
            "in": "query",
            "name": "channel_id",
            "type": "string",
            "x-example": "homefeed.food_v3"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/xiaohongshu.exploreResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Anonymous Xiaohongshu explore/channel feed",
        "tags": [
          "xiaohongshu"
        ]
      }
    },
    "/xiaohongshu/note": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one public Xiaohongshu note normalized from the site's server-rendered page state: note id, type, title, description text (including hashtags), topic tags, image URLs, an optional stable video URL with duration, publish time, author card, and public interaction counters. Pass url with the note_url returned by /xiaohongshu/explore. The URL must be an xiaohongshu.com /explore/<id> or /discovery/item/<id> link carrying its xsec_token; a note id alone is not accessible anonymously, and a stale token returns not-found, so re-run /xiaohongshu/explore to mint a fresh one. Comments are not included because the anonymous page state does not carry them.",
        "operationId": "xiaohongshu-note",
        "parameters": [
          {
            "description": "Note URL carrying xsec_token, normally the note_url returned by /xiaohongshu/explore. Pass url, or both note_id and xsec_token.",
            "in": "query",
            "name": "url",
            "type": "string",
            "x-example": "https://www.xiaohongshu.com/explore/0123456789abcdef01234567?xsec_token=SYNTHETIC-EXAMPLE-TOKEN-0001&xsec_source=pc_feed"
          },
          {
            "description": "24-character hex note id from an explore card (requires xsec_token)",
            "in": "query",
            "name": "note_id",
            "type": "string",
            "x-example": "0123456789abcdef01234567"
          },
          {
            "description": "Short-lived feed-issued token that accompanies note_id",
            "in": "query",
            "name": "xsec_token",
            "type": "string",
            "x-example": "SYNTHETIC-EXAMPLE-TOKEN-0001"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/xiaohongshu.noteResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Anonymous Xiaohongshu note detail",
        "tags": [
          "xiaohongshu"
        ]
      }
    },
    "/xiaohongshu/note-comments": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one page of a public note's comments using a browser-minted signed request, with no account or login. Pass the note_url returned by /xiaohongshu/explore (it carries the required xsec_token). Each item includes the comment id, text, like/sub-comment counters, creation time, IP location when the site exposes it, a public author card, and up to five replies. has_more and cursor continue pagination: pass the returned cursor to fetch the next page. Comments are read from the anonymous signed API, so a stale note token returns an upstream error; re-run /xiaohongshu/explore for a fresh note_url. Search results and profiles are not exposed because they require login.",
        "operationId": "xiaohongshu-note-comments",
        "parameters": [
          {
            "description": "Note URL carrying xsec_token, normally the note_url returned by /xiaohongshu/explore. Pass url, or both note_id and xsec_token.",
            "in": "query",
            "name": "url",
            "type": "string",
            "x-example": "https://www.xiaohongshu.com/explore/0123456789abcdef01234567?xsec_token=SYNTHETIC-EXAMPLE-TOKEN-0001&xsec_source=pc_feed"
          },
          {
            "description": "24-character hex note id from an explore card (requires xsec_token)",
            "in": "query",
            "name": "note_id",
            "type": "string",
            "x-example": "0123456789abcdef01234567"
          },
          {
            "description": "Short-lived feed-issued token that accompanies note_id",
            "in": "query",
            "name": "xsec_token",
            "type": "string",
            "x-example": "SYNTHETIC-EXAMPLE-TOKEN-0001"
          },
          {
            "description": "Pagination cursor from a previous response",
            "in": "query",
            "name": "cursor",
            "type": "string",
            "x-example": "cursor-1"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/xiaohongshu.commentsResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Anonymous Xiaohongshu note comments",
        "tags": [
          "xiaohongshu"
        ]
      }
    },
    "/xiaohongshu/search-suggest": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns search suggestions for a partially typed keyword using a browser-minted signed request. Suggestions come from the site's own anonymous suggestion API and require no account or login. Each item carries the suggested text plus optional highlight flags and the suggestion's search type. Only the suggestion list is returned; search *results* need a logged-in session and are not exposed. The signer is a shared browser worker, so this endpoint is slower than the plain page endpoints (roughly a browser-backed request, not a single HTTP call); if no signer worker is available it returns 503.",
        "operationId": "xiaohongshu-search-suggest",
        "parameters": [
          {
            "description": "Partially typed search keyword",
            "in": "query",
            "name": "keyword",
            "required": true,
            "type": "string",
            "x-example": "coffee"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/xiaohongshu.suggestResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Anonymous Xiaohongshu search suggestions",
        "tags": [
          "xiaohongshu"
        ]
      }
    }
  },
