  "operations": {
    "xiaohongshu-explore": {
      "id": "xiaohongshu-explore",
      "method": "GET",
      "path": "/xiaohongshu/explore",
      "pathParams": [],
      "queryParams": [
        {
          "name": "channel_id",
          "in": "query",
          "type": "string"
        }
      ],
      "bodyParam": null,
      "bodyRequired": false,
      "params": [
        {
          "description": "Optional explore channel id from the channels list in a previous response. Unknown values are rejected; omit for the default feed.",
          "in": "query",
          "name": "channel_id",
          "type": "string",
          "x-example": "homefeed.food_v3"
        }
      ],
      "produces": [
        "application/json"
      ],
      "security": [
        "ApiKeyAuth"
      ]
    },
    "xiaohongshu-note": {
      "id": "xiaohongshu-note",
      "method": "GET",
      "path": "/xiaohongshu/note",
      "pathParams": [],
      "queryParams": [
        {
          "name": "url",
          "in": "query",
          "type": "string"
        },
        {
          "name": "note_id",
          "in": "query",
          "type": "string"
        },
        {
          "name": "xsec_token",
          "in": "query",
          "type": "string"
        }
      ],
      "bodyParam": null,
      "bodyRequired": false,
      "params": [
        {
          "description": "Note URL carrying xsec_token, normally the note_url returned by /xiaohongshu/explore. Pass url, or both note_id and xsec_token.",
          "in": "query",
          "name": "url",
          "type": "string",
          "x-example": "https://www.xiaohongshu.com/explore/0123456789abcdef01234567?xsec_token=SYNTHETIC-EXAMPLE-TOKEN-0001&xsec_source=pc_feed"
        },
        {
          "description": "24-character hex note id from an explore card (requires xsec_token)",
          "in": "query",
          "name": "note_id",
          "type": "string",
          "x-example": "0123456789abcdef01234567"
        },
        {
          "description": "Short-lived feed-issued token that accompanies note_id",
          "in": "query",
          "name": "xsec_token",
          "type": "string",
          "x-example": "SYNTHETIC-EXAMPLE-TOKEN-0001"
        }
      ],
      "produces": [
        "application/json"
      ],
      "security": [
        "ApiKeyAuth"
      ]
    },
